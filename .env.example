# Copy to .env.local and fill in. Both services are free and need no credit card.

# Neon Postgres — https://neon.com
# Create a project, then copy the POOLED connection string.
# pgvector is available on the free plan; the first migration enables it.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Google AI Studio — https://aistudio.google.com/apikey
# Free tier covers both the Gemini Flash chat models and gemini-embedding-001.
# Note: on the free tier Google may use submitted content to improve their products,
# so use public or synthetic documents only.
GOOGLE_GENERATIVE_AI_API_KEY="..."
